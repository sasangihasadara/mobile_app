{
  "name": "library-reserve-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "frontend": "npm --prefix frontend start",
    "android": "npm --prefix frontend run android",
    "ios": "npm --prefix frontend run ios",
    "web": "npm --prefix frontend run web",
    "backend": "node --env-file-if-exists=backend/.env backend/server.cjs",
    "test:backend": "node --test backend/server.test.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
