# Copy this file to backend/.env. Keep database credentials on the backend only.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=library_reserve
PORT=3000
CORS_ORIGIN=http://localhost:8081

# Atlas alternative (replace placeholders and URL-encode password characters):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
